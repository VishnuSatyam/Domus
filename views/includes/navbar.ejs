<header class="site-header border-bottom">
  <nav class="navbar navbar-expand-lg">
    <div class="container-fluid header-top">
      <a class="navbar-brand brand-link" href="/listings" aria-label="Domus listings">
        <i class="bi bi-house-heart-fill" aria-hidden="true"></i>
        <span>domus</span>
      </a>

      <div class="header-categories d-none d-lg-flex" aria-label="Explore categories">
        <a class="category-link <%= !activeCategory || activeCategory === 'all' ? 'active' : '' %>" href="/listings"><i class="bi bi-globe2"></i><span>All</span></a>
        <a class="category-link <%= activeCategory === 'home' ? 'active' : '' %>" href="/listings?category=home"><i class="bi bi-house-door"></i><span>Homes</span></a>
        <a class="category-link <%= activeCategory === 'experience' ? 'active' : '' %>" href="/listings?category=experience"><i class="bi bi-balloon-heart"></i><span>Experiences</span></a>
        <a class="category-link <%= activeCategory === 'service' ? 'active' : '' %>" href="/listings?category=service"><i class="bi bi-bell"></i><span>Services</span></a>
      </div>

      <button
        class="navbar-toggler"
        type="button"
        data-bs-toggle="collapse"
        data-bs-target="#navbarNavAltMarkup"
        aria-controls="navbarNavAltMarkup"
        aria-expanded="false"
        aria-label="Toggle navigation"
      >
        <i class="bi bi-list"></i>
      </button>

      <div class="collapse navbar-collapse header-links" id="navbarNavAltMarkup">
        <div class="navbar-nav ms-lg-auto align-items-lg-center">
          <a class="nav-link" href="/listings/new">Add New Listing</a>
          <a class="nav-link" href="/listings">All Listings</a>
          <% if (!currUser) { %>
          <a class="nav-link auth-link" href="/signup">Sign up</a>
          <a class="nav-link auth-link" href="/login">Log in</a>
          <% } else { %>
          <a class="nav-link auth-link" href="/logout">Log out</a>
          <% } %>
          <span class="header-icon d-none d-lg-inline-flex"><i class="bi bi-globe2"></i></span>
        </div>
      </div>
    </div>

    <div class="container-fluid d-lg-none mobile-categories">
      <a class="category-link <%= !activeCategory || activeCategory === 'all' ? 'active' : '' %>" href="/listings"><i class="bi bi-globe2"></i><span>All</span></a>
      <a class="category-link <%= activeCategory === 'home' ? 'active' : '' %>" href="/listings?category=home"><i class="bi bi-house-door"></i><span>Homes</span></a>
      <a class="category-link <%= activeCategory === 'experience' ? 'active' : '' %>" href="/listings?category=experience"><i class="bi bi-balloon-heart"></i><span>Experiences</span></a>
      <a class="category-link <%= activeCategory === 'service' ? 'active' : '' %>" href="/listings?category=service"><i class="bi bi-bell"></i><span>Services</span></a>
    </div>

    <form class="header-search" role="search" action="/listings" method="GET">
      <label class="search-field"><span>Where</span><input type="search" name="where" value="<%= typeof search !== 'undefined' ? search.where : '' %>" placeholder="Search destinations" aria-label="Search destination" /></label>
      <label class="search-field d-none d-sm-flex"><span>When</span><span class="date-inputs"><input type="date" name="startDate" value="<%= typeof search !== 'undefined' ? search.startDate : '' %>" aria-label="Check-in date" /><input type="date" name="endDate" value="<%= typeof search !== 'undefined' ? search.endDate : '' %>" aria-label="Check-out date" /></span></label>
      <label class="search-field d-none d-md-flex"><span>Who</span><input type="number" name="guests" min="1" max="30" value="<%= typeof search !== 'undefined' ? search.guests : '' %>" placeholder="Add guests" aria-label="Number of guests" /></label>
      <button class="search-button" type="submit" aria-label="Search listings"><i class="bi bi-search"></i></button>
    </form>
  </nav>
</header>
