<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Domus</title>
</head>
<body>
    <h3>Edit your Listing</h3>

    <form method="POST" action="/listings/<%= listing._id %>?_method=PUT">
        <label for="title">Title</label>
        <input type="text" name="listing[title]" id="title" value="<%= listing.title %>">
        <br> <br>
        <label for="description">Description</label>
        <textarea type="text" name="listing[description]" id="description"><%= listing.description %></textarea>
        <br><br>
        <label for="image">Image</label>
        <input type="text" name="listing[image]" id="image" value="<%= listing.image.url %>">
        <br> <br>
        <label for="price">Price</label>
        <input type="number" name="listing[price]" id="price" value="<%= listing.price %>">
        <br><br>
        <label for="location">Location</label>
        <input type="text" name="listing[location]" id="location" value="<%= listing.location %>">
        <br><br>
        <label for="country">Country</label>
        <input type="text" name="listing[country]" id="country" value="<%= listing.country %>">
        <br>
        <button>Edit Listing</button>

    </form>
</body>
</html>