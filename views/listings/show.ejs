<% layout("layouts/boilerplate") %>

<div class="row mt-3">
  <div class="col-6 offset-3">
    <h3><%= listing.title %></h3>

    <div class="card">
      <img
        src="<%= listing.image.url %>"
        class="card-img-top show-img"
        alt="listing image"
        style="height: 25rem; object-fit: cover"
      />

      <div class="card-body">
        <p class="card-text"><%= listing.description %></p>

        <p class="card-text">
          <b>Price:</b> &#8377;<%= listing.price.toLocaleString("en-IN")
          %>/night
        </p>

        <p class="card-text"><b>Location:</b> <%= listing.location %></p>

        <p class="card-text"><b>Country:</b> <%= listing.country %></p>
      </div>
    </div>

    <% if (currUser && listing.owner && listing.owner.equals(currUser._id)) { %>
    <div class="mt-3 d-flex gap-2">
      <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark">
        Edit
      </a>

      <form action="/listings/<%= listing._id %>?_method=DELETE" method="POST">
        <button class="btn btn-danger">Delete</button>
      </form>
    </div>
    <% } %>
  </div>

  <div class="col-8 offset-3">
    <hr />
    <h4>Leave a Review</h4>
    <% if (currUser) { %>
    <form
      action="/listings/<%= listing._id  %>/reviews"
      class="needs-validation mb-3"
      novalidate
      method="POST"
    >
      <div class="mb-3 mt-3">
        <label class="form-label">Rating</label>
        <fieldset class="starability-slot" role="radiogroup" aria-label="Select a rating">
          <legend>Rating</legend>
          <input
            type="radio"
            id="review-rate-1"
            name="review[rating]"
            value="1"
            required
          />
          <label for="review-rate-1" title="Terrible">1 star</label>
          <input type="radio" id="review-rate-2" name="review[rating]" value="2" />
          <label for="review-rate-2" title="Not good">2 stars</label>
          <input type="radio" id="review-rate-3" name="review[rating]" value="3" />
          <label for="review-rate-3" title="Average">3 stars</label>
          <input type="radio" id="review-rate-4" name="review[rating]" value="4" />
          <label for="review-rate-4" title="Very good">4 stars</label>
          <input type="radio" id="review-rate-5" name="review[rating]" value="5" />
          <label for="review-rate-5" title="Amazing">5 stars</label>
          <span class="starability-focus-ring"></span>
        </fieldset>
      </div>

      <div class="mb-3 mt-3">
        <label for="comment" class="form-label">Comments</label>
        <textarea
          name="review[comment]"
          id="comment"
          cols="30"
          rows="5"
          class="form-control"
          required
        ></textarea>
        <div class="invalid-feedback">Please add some comments for review</div>
      </div>

      <button class="btn btn-outline-dark">Submit</button>
    </form>
    <% } else { %>
      <p class="text-muted">Please <a href="/login">log in</a> to leave a review.</p>
    <% } %>

    <hr />
    <h4>All Reviews</h4>
    <% if (listing.reviews.length === 0) { %>
      <p class="text-muted">No reviews yet. Be the first to leave one.</p>
    <% } %>

    <div class="row row-cols-1 row-cols-md-2 g-3 mb-4">
      <% for (const review of listing.reviews) { %>
        <div class="col">
          <div class="card border p-3 h-100">
            <p class="mb-1 fw-semibold"><%= review.author ? review.author.username : "Unknown user" %></p>
            <p class="mb-3"><%= review.comment %></p>
            <p
              class="starability-result mb-3"
              data-rating="<%= review.rating %>"
              aria-label="<%= review.rating %> out of 5 stars"
            ></p>
            <% if (currUser && review.author && review.author.equals(currUser._id)) { %>
            <form
              action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"
              method="POST"
              class="mt-3"
            >
              <button class="btn btn-sm btn-outline-danger">Delete review</button>
            </form>
            <% } %>
          </div>
        </div>
      <% } %>
    </div>
  </div>
</div>
