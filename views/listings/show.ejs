<% layout("layouts/boilerplate") %>

<div class="row mt-3">
  <div class="col-6 offset-3">
    <h3><%= listing.title %></h3>

    <div class="card">
      <img
        src="<%= listing.image.url %>"
        class="card-img-top show-img"
        alt="listing image"
        style="height: 25rem; object-fit: cover"
      />

      <div class="card-body">
        <p class="card-text"><%= listing.description %></p>

        <p class="card-text">
          <b>Price:</b> &#8377;<%= listing.price.toLocaleString("en-IN")
          %>/night
        </p>

        <p class="card-text"><b>Location:</b> <%= listing.location %></p>

        <p class="card-text"><b>Country:</b> <%= listing.country %></p>
      </div>
    </div>

    <div class="mt-3 d-flex gap-2">
      <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark">
        Edit
      </a>

      <form action="/listings/<%= listing._id %>?_method=DELETE" method="POST">
        <button class="btn btn-danger">Delete</button>
      </form>
    </div>
  </div>

  <div class="col-8 offset-3">
    <hr />
    <h4>Leave a Review</h4>
    <form action="" class="mb-3">
      <div class="mb-3 mt-3">
        <label for="rating" class="form-label">Rating</label>
        <input
          type="range"
          man="1"
          max="5"
          name="review[rating]"
          class="form-range"
        />
      </div>

      <div class="bb-3 mt-3">
        <label for="comment" class="form-label">Comments</label>
        <textarea
          name="review[comment]"
          id="comment"
          cols="30"
          rows="5"
        ></textarea>
      </div>

      <button class="btn btn-outline-dark">Submit</button>
    </form>
  </div>
</div>
